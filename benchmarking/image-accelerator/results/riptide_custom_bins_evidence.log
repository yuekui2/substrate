--- generated patch ---
spec:
  template:
    spec:
      containers:
      - env:
        - name: RIPTIDE_BIN_DIR
          value: /home/kubernetes/bin/ate-riptide
        name: riptide-provider
      initContainers:
      - command:
        - /bin/sh
        - -ec
        - |
          dst=/host-bin/ate-riptide
          mkdir -p "${dst}"
          for f in /riptide/*; do
            n="$(basename "${f}")"
            cp "${f}" "${dst}/.${n}.tmp"
            chmod 0755 "${dst}/.${n}.tmp"
            mv -f "${dst}/.${n}.tmp" "${dst}/${n}"
          done
        image: us-central1-docker.pkg.dev/kuiyue-gke-dev/kuiyue-gke-dev-repo/riptide-bins@sha256:e6648c4d79f258df2ad6aea531428ebfc0d7fec5010b7adca48307f3479343f5
        name: install-riptide-bins
        volumeMounts:
        - mountPath: /host-bin
          name: kube-home-bin
      volumes:
      - hostPath:
          path: /home/kubernetes/bin
          type: Directory
        name: kube-home-bin
