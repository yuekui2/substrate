    ${secondary_boot_data_disk_mount_points_flag} \
    --disable-duplicate-layer-support=false \
    --enable-metric-exporter=false \
    ${enable_v2_api_flag} &
  snapshotter_pid=$!
  wait -n "${gcfsd_pid}" "${snapshotter_pid}"
 
