10361 /bin/bash :: /bin/bash -ec 
  readonly gcfs_root="/var/lib/ate/accelerator-image-cache/riptide-gcfs"
  readonly gcfsd_mnt_dir="${gcfs_root}/mnt"
  readonly gcfs_socket_path="/run/gcfsd/grpc.sock"
  readonly layer_cache_dir="${gcfs_root}/snapshotter/layers"
  readonly images_in_use_db_path="${gcfs_root}/gcfsd/images_in_use.db"
  readonly sentinel_file_path="${gcfs_root}/gcfsd_sentinel.txt"

  mount --make-rslave /run
  mount --bind /run/ate/gcfsd /run/gcfsd
  mount --make-private /run/gcfsd

  gcfs_cache_size_flag=""
  if [[ -n "${GCFSD_CACHE_SIZE_MIB:-}" ]]; then
    each_cache_size=$((GCFSD_CACHE_SIZE_MIB / 2))
    gcfs_cache_size_flag="--max_content_cache_size_mb=${each_cache_size} --max_large_files_cache_size_mb=${each_cache_size}"
  fi

  gcfs_layer_caching_flag=""
  if [[ "${ENABLE_GCFS_LAYER_CACHING:-false}" == "true" ]]; then
    gcfs_layer_caching_flag="--layer_cache_dir=${layer_cache_dir}"
  fi

  client_version_flag=""
  if [[ -n "${KUBELET_VERSION:-}" ]]; then
    client_version_flag="--client_version=${KUBELET_VERSION}"
  fi

  enable_id_mapping_flag=""
  if [[ "${ENABLE_GCFS_V2_API:-false}" == "true" && "${ENABLE_USERNAMESPACE_SUPPORT:-false}" == "true" ]]; then
    enable_id_mapping_flag="--enable_id_mapping"
  fi

  gcfs_read_ahead_flag="--enable_single_flighting=true --read_ahead_max_blocks=10 --read_ahead_cache_size_ratio=0.1"

  if [[ -f "${KUBE_HOME}/gcfsd_application_default_credentials.json" ]]; then
    export GCFSD_METRICS_ADC_CONFIG_PATH="${KUBE_HOME}/gcfsd_application_default_credentials.json"
  fi

  mkdir -p "${gcfsd_mnt_dir}" "${layer_cache_dir}" "$(dirname "${images_in_use_db_path}")"

  gcfsd_pid=""
  snapshotter_pid=""
  cleanup() {
    kill -TERM ${snapshotter_pid} ${gcfsd_pid} 2>/dev/null || true
    wait ${snapshotter_pid} ${gcfsd_pid} 2>/dev/null || true
    umount -l "${gcfsd_mnt_dir}" 2>/dev/null || true
    rm -f /run/ate/gcfs-snapshotter.sock "${gcfs_socket_path}" /run/gcfsd/keychain.sock /run/gcfsd/downloader.sock
  }
  trap cleanup TERM INT EXIT

  GOGC=10 "${GCFSD_BIN}" \
    --mount_point="${gcfsd_mnt_dir}" \
    --control_server_socket_path="${gcfs_socket_path}" \
    --downloader_uds_path=/run/gcfsd/downloader.sock \
    --sentinel_file_path="${sentinel_file_path}" \
    --containerd_uds_path="" \
    --event_reporter_type=none \
    --port=11254 \
    ${gcfs_cache_size_flag} \
    ${gcfs_layer_caching_flag} \
    --images_in_use_db_path="${images_in_use_db_path}" \
    ${enable_id_mapping_flag} \
    --enable_pull_secret_keychain \
    --client_name=GKE \
    ${client_version_flag} \
    ${gcfs_read_ahead_flag} &
  gcfsd_pid=$!

  for _ in $(seq 1 150); do
    [[ -S "${gcfs_socket_path}" && -S /run/gcfsd/keychain.sock ]] && break
    sleep 0.1
  done

  mkdir -p /etc/containerd-gcfs-grpc
  touch "${gcfs_root}/config.toml"
  export HOME=/root
  if [[ -f "${KUBE_HOME}/gcfs_snaphotter_application_default_credentials.json" ]]; then
    export GCFS_SNAPSHOTTER_METRICS_ADC_CONFIG_PATH="${KUBE_HOME}/gcfs_snaphotter_application_default_credentials.json"
  fi

  secondary_boot_disk_mount_points_flag=""
  if [[ -n "${SECONDARY_BOOT_DISKS:-}" ]]; then
    secondary_boot_disk_mount_points_flag="--secondary-disk-mount-points=${SECONDARY_BOOT_DISKS}"
  fi
  secondary_boot_data_disk_mount_points_flag=""
  if [[ -n "${SECONDARY_BOOT_DATA_DISKS:-}" ]]; then
    secondary_boot_data_disk_mount_points_flag="--secondary-data-disk-mount-points=${SECONDARY_BOOT_DATA_DISKS}"
  fi

  enable_v2_api_flag=""
  if [[ "${ENABLE_GCFS_V2_API:-false}" == "true" ]]; then
