# One arm's WorkerPool: 3 nodes x 16 workers of 1 vCPU / 2 GiB, Guaranteed.
# Actors are 100m / 204Mi, so each worker hosts 10 and the pool 480.
# deploy.sh fills in ${ARM}.
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: bench-${ARM}
  namespace: imgbench
  labels:
    workload: bench-${ARM}
spec:
  replicas: 48
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor
  sandboxClasses:
  - name: gvisor
  template:
    nodeSelector:
      bench-arm: ${ARM}
    resources:
      requests:
        cpu: "1"
        memory: 2Gi
      limits:
        cpu: "1"
        memory: 2Gi
