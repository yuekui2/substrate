# One loader Job. run.sh fills in ${JOB}, ${ARM}, ${MODE} and ${EXTRA_ARGS}
# (extra args start with a comma). It runs on the system pool, away from the
# bench nodes. The loader lingers after it finishes so run.sh can copy
# /results out.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB}
  namespace: imgbench
  labels:
    app: imgbench-loader
    arm: ${ARM}
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 172800
  template:
    metadata:
      labels:
        app: imgbench-loader
        arm: ${ARM}
    spec:
      restartPolicy: Never
      serviceAccountName: loader
      nodeSelector:
        cloud.google.com/gke-nodepool: bench-system
      containers:
      - name: loader
        image: ko://go.ate.dev/substrate/benchmarking/image-plugin/loader
        args: [${MODE}, -arm, ${ARM}, -atespace, ${ATESPACE}, -workload, bench-${ARM},
          -snapshot-location, "gs://snapshot-substrate-test-kuiyue-gke-dev/image-plugin-bench/",
          -out, /results/out.jsonl, -linger, 2h ${EXTRA_ARGS}]
        resources:
          requests:
            cpu: "2"
            memory: 2Gi
        volumeMounts:
        - name: config
          mountPath: /config
        - name: results
          mountPath: /results
      volumes:
      - name: config
        configMap:
          name: imgbench-images
      - name: results
        emptyDir: {}
